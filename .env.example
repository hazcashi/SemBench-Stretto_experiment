# Never commit the filled .env. Acquire gated access to BOTH Llama checkpoints first.
HF_TOKEN=
OPENAI_API_KEY=
# Pin the published immutable digest in this variable after build/publish.
# The launcher refuses an empty image reference; no nonexistent release is assumed.
STRETTO_IMAGE=
STRETTO_DATA_DIR=./data
STRETTO_RESULTS_DIR=./results
